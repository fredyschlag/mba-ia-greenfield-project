{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "globalSetup": "<rootDir>/../src/test/global-setup.ts",
  "setupFiles": ["<rootDir>/../src/test/test-env.setup.ts", "dotenv/config"]
}
