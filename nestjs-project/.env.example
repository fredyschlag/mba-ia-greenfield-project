# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM="StreamTube <noreply@streamtube.com>"

# Object storage (MinIO locally, Amazon S3 in production)
# S3_PUBLIC_ENDPOINT is opened by the browser on the host, so it is the only
# value allowed to use localhost. Omit S3_ENDPOINT on AWS.
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=streamtube

# Local-only credentials shared by MinIO and the AWS SDK. Omit them on AWS.
AWS_ACCESS_KEY_ID=streamtube
AWS_SECRET_ACCESS_KEY=streamtube-dev-secret

# Queue (ElasticMQ locally, Amazon SQS in production). Omit SQS_ENDPOINT on AWS.
SQS_ENDPOINT=http://elasticmq:9324
SQS_REGION=us-east-1
SQS_VIDEO_PROCESSING_QUEUE_URL=http://elasticmq:9324/000000000000/video-processing
SQS_VIDEO_PROCESSING_DLQ_URL=http://elasticmq:9324/000000000000/video-processing-dlq

# Videos
VIDEO_MAX_UPLOAD_BYTES=10737418240
